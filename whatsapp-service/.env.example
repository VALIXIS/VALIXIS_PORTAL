# ── Server configuration ──────────────────────────────────────────────────────

# TCP port the Express HTTP server listens on.
# Change this if 3001 is already occupied on your machine.
PORT=3001

# ── Webhook configuration ─────────────────────────────────────────────────────

# Default WhatsApp recipient JID used by POST /supabase-webhook when the
# incoming Supabase record does not contain a `phone` field.
# Format: countryCode + number (no spaces or +) + @c.us
# Example: India (+91) → 91XXXXXXXXXX@c.us
WEBHOOK_RECIPIENT=919603416707@c.us

# Optional: absolute path to a Chrome/Chromium executable.
# Leave blank to use auto-detection (Windows → Program Files, macOS → /Applications, Linux → /usr/bin).
# CHROME_PATH=
