{
  "name": "VALIXIS Portal Flutter Dev Environment",
  "image": "ghcr.io/cirruslabs/flutter:3.24.0",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code"
      ],
      "settings": {
        "dart.flutterSdkPath": "/sdks/flutter"
